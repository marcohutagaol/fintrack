generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH (NextAuth / Auth.js) ====================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  accounts      Account[]
  sessions      Session[]
  setting       UserSetting?
  categories    Category[]
  transactions  Transaction[]
  installments  Installment[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== APP DATA ====================

model UserSetting {
  id                  String  @id @default(uuid())
  userId              String  @unique
  minBalanceTarget    Float   @default(0)
  estimatedNextIncome Float   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id           String        @id @default(uuid())
  name         String
  userId       String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([name, userId])
}

model Transaction {
  id          String    @id @default(uuid())
  type        Type
  amount      Float
  description String?
  date        DateTime  @default(now())

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Installment {
  id             String   @id @default(uuid())
  itemName       String
  totalPrice     Float
  monthlyPayment Float
  totalMonths    Int
  paidMonths     Int      @default(0)
  startDate      DateTime @default(now())
  isCompleted    Boolean  @default(false)

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Type {
  INCOME
  EXPENSE
}